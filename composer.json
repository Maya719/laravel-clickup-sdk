{
    "name": "maya719/clickup",
    "description": "PHP SDK and Laravel package for interacting with the ClickUp API v2.",
    "keywords": [
        "clickup",
        "laravel",
        "sdk",
        "api",
        "webhooks"
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Maya719",
            "email": "shoaib.mobipixels@gmail.com"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^7.8|^8.0",
        "illuminate/contracts": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.5|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Maya719\\ClickUp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Maya719\\ClickUp\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Maya719\\ClickUp\\ClickUpServiceProvider"
            ],
            "aliases": {
                "ClickUp": "Maya719\\ClickUp\\Facades\\ClickUp"
            }
        }
    },
    "config": {
        "sort-packages": true
    }
}
